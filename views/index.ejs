<%
  // Branded <title> for the SERP (58 chars). og:title / twitter:title keep the
  // descriptive "directory" framing below — it reads better on social cards.
  const title = `Pest Control & Exterminators Near You | The Local Pest Pro`;
  const socialTitle = `Pest Control Directory | Find Local Exterminators Near You`;
  const metaDesc = 'Nationwide pest control directory. Find local exterminators for ants, roaches, termites, bed bugs, rodents, mosquitoes, and more. Call to ask about availability, licensing, and pricing.';
  const canonical = '/';
  // No branded 1200x630 social card exists yet, so point og:image / twitter:image
  // at the favicon (a real file that returns 200) instead of a 404. Swap this for
  // a proper Open Graph card when one is designed.
  const ogImage = `${SITE.DOMAIN}/favicon.png`;
  const schemaPhone = SITE.PHONE_TEL.replace(/^\+1(\d{3})(\d{3})(\d{4})$/, '+1-$1-$2-$3');
  const phoneTel = SITE.PHONE_TEL;
  const phoneDisplay = SITE.PHONE_DISPLAY;

  const schema = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": `${SITE.DOMAIN}/#organization`,
        "name": SITE.NAME,
        "url": `${SITE.DOMAIN}/`,
        "logo": `${SITE.DOMAIN}/favicon.png`,
        "telephone": schemaPhone,
        "areaServed": { "@type": "Country", "name": "US" }
      },
      {
        "@type": "WebSite",
        "@id": `${SITE.DOMAIN}/#website`,
        "url": `${SITE.DOMAIN}/`,
        "name": SITE.NAME,
        "publisher": { "@id": `${SITE.DOMAIN}/#organization` }
      },
      {
        "@type": "FAQPage",
        "@id": `${SITE.DOMAIN}/#faq`,
        "mainEntity": [
          { "@type": "Question", "name": "How does the pest control directory work?", "acceptedAnswer": { "@type": "Answer", "text": "Click your state on the map, then drill down to your area to find the pest control contractor serving your area. One call connects you with a local exterminator — ask about licensing, pricing, and availability when you call." } },
          { "@type": "Question", "name": "How much does pest control cost?", "acceptedAnswer": { "@type": "Answer", "text": "Pest control pricing depends on the pest, how severe the infestation is, the size of your property, and whether you need a one-time treatment or a recurring plan. General pest treatments are usually the most affordable, while specialty work like termite or bed bug remediation costs more because of the equipment and follow-up involved. Ask us for a property-specific quote before any work begins." } },
          { "@type": "Question", "name": "How do I find a licensed exterminator near me?", "acceptedAnswer": { "@type": "Answer", "text": "Click your state on the map above, then select your area. Ask the contractor listed about licensing and insurance for your service area when you call." } },
          { "@type": "Question", "name": "Are the treatments safe for kids and pets?", "acceptedAnswer": { "@type": "Answer", "text": "Treatment products, methods, and re-entry intervals vary by contractor. Ask us which products they use and about any re-entry interval after an application." } },
          { "@type": "Question", "name": "What pests do these contractors handle?", "acceptedAnswer": { "@type": "Answer", "text": "The full range of household pests: ants, cockroaches, termites, bed bugs, rodents (mice and rats), mosquitoes, spiders, fleas and ticks, wasps and hornets, silverfish, earwigs, and more — plus recurring prevention plans." } }
        ]
      }
    ]
  });

  const extraHead = `
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="${SITE.NAME}">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="${SITE.DOMAIN}/">
    <meta property="og:title" content="${socialTitle}">
    <meta property="og:description" content="${metaDesc}">
    <meta property="og:image" content="${ogImage}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="${socialTitle}">
    <meta name="twitter:description" content="${metaDesc}">
    <meta name="twitter:image" content="${ogImage}">
    <meta name="robots" content="index, follow">
  `;
%>
<%- include('layout', { title, metaDesc, canonical, schema, extraHead, body: `

<section class="hero">
  <div class="container hero-content">
    <div class="hero-badge">Nationwide Pest Control Directory</div>
    <h1>Find Pest Control Near You</h1>
    <p class="hero-sub">Local pest control, by state and city. Click your state on the map below to find a pest control pro in your area, or call us now. One call, problem solved.</p>
    <div class="hero-actions">
      <a href="tel:${phoneTel}" class="btn-primary">📞 Call ${phoneDisplay}</a>
      <a href="#map-section" class="btn-ghost">Find My Area</a>
      <a href="#services" class="btn-ghost">Browse Services</a>
    </div>
    <figure class="page-photo">
      <img src="/images/homepage.webp" alt="Pest control technician inspecting a home for pests" loading="lazy" onerror="this.closest('figure').style.display='none'">
      <figcaption>Pest control work — illustrative photo of pest control work.</figcaption>
    </figure>
  </div>
</section>

<section class="map-section" id="map-section">
  <div class="container">
    <div class="section-header">
      <h2>Select Your State</h2>
      <p>Hover to preview, click to find your local pest control pro</p>
    </div>
    <div id="map-tooltip" class="map-tooltip"></div>
    <svg id="us-map"></svg>
    <p class="map-hint">Click any state to find a local exterminator</p>
    <div id="coming-soon-panel" style="display:none;margin-top:16px;padding:16px 20px;background:var(--green-light);border:1px solid var(--green-border);border-radius:12px;text-align:center;">
      <p style="margin:0 0 8px;"><strong id="coming-soon-state">That state</strong> is coming soon — it is not built yet on this site.</p>
      <p style="margin:0;">Call us and we can help: <a href="tel:${phoneTel}" style="font-weight:700;color:var(--green);">${phoneDisplay}</a></p>
    </div>
  </div>
</section>

<section class="counties-section" id="services" style="background:var(--green-light);border-top:1px solid var(--green-border);">
  <div class="container">
    <div class="section-header">
      <h2>Pest Control Services Nationwide</h2>
      <p>Contractors in our directory handle a range of household pests. Find a local pro for any of these in your area, and ask about services, licensing, and pricing when you call.</p>
    </div>
    <ul class="counties-grid">
      <li><a href="/termite-control/">🐛 Termite Treatment</a></li>
      <li><a href="/bed-bug-treatment/">🛏️ Bed Bug Treatment</a></li>
      <li><a href="/cockroach-control/">🪳 Cockroach Control</a></li>
      <li><a href="/mosquito-control/">🦟 Mosquito Control</a></li>
      <li><a href="/rodent-control/">🐀 Rodent Control</a></li>
      <li><a href="/pest-control/">🐌 General Pest Control</a></li>
    </ul>
  </div>
</section>

<section class="about" id="how-it-works">
  <div class="container">
    <div class="section-header">
      <h2>How It Works</h2>
      <p>We connect homeowners directly with the best local pest control professionals in their area.</p>
    </div>
    <div class="features">
      <div class="feature">
        <span class="feature-icon">📍</span>
        <h3>Find Your Area</h3>
        <p>Click your state on the map above, then select your area to find the exterminator serving your area.</p>
      </div>
      <div class="feature">
        <span class="feature-icon">📞</span>
        <h3>Call a Local Pro</h3>
        <p>Get connected directly with a contractor who knows your local pests. Ask about treatments, pricing, and availability when you call.</p>
      </div>
      <div class="feature">
        <span class="feature-icon">✅</span>
        <h3>Problem Solved</h3>
        <p>Professionals handle treatment, exclusion, and prevention. Ask about any guarantee when you call.</p>
      </div>
    </div>
  </div>
</section>

<section class="county-content">
  <div class="container">
    <h2>Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:16px;margin-top:16px;">
      <details style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;" open>
        <summary style="padding:16px 20px;font-weight:600;cursor:pointer;font-size:0.97rem;list-style:none;display:flex;justify-content:space-between;align-items:center;">How does the pest control directory work?<span style="font-size:1.2rem;flex-shrink:0;margin-left:12px;">+</span></summary>
        <div style="padding:0 20px 16px;color:#374151;line-height:1.7;font-size:0.93rem;border-top:1px solid #f3f4f6;">Click your state on the map, then drill down to your area to find the pest control contractor serving your area. One call connects you with a local exterminator — ask about licensing, pricing, and availability when you call.</div>
      </details>
      <details style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
        <summary style="padding:16px 20px;font-weight:600;cursor:pointer;font-size:0.97rem;list-style:none;display:flex;justify-content:space-between;align-items:center;">How much does pest control cost?<span style="font-size:1.2rem;flex-shrink:0;margin-left:12px;">+</span></summary>
        <div style="padding:0 20px 16px;color:#374151;line-height:1.7;font-size:0.93rem;border-top:1px solid #f3f4f6;">Pest control pricing depends on the pest, how severe the infestation is, the size of your property, and whether you need a one-time treatment or a recurring plan. General pest treatments are usually the most affordable, while specialty work like termite or bed bug remediation costs more because of the equipment and follow-up involved. Ask us for a property-specific quote before any work begins.</div>
      </details>
      <details style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
        <summary style="padding:16px 20px;font-weight:600;cursor:pointer;font-size:0.97rem;list-style:none;display:flex;justify-content:space-between;align-items:center;">How do I find a licensed exterminator near me?<span style="font-size:1.2rem;flex-shrink:0;margin-left:12px;">+</span></summary>
        <div style="padding:0 20px 16px;color:#374151;line-height:1.7;font-size:0.93rem;border-top:1px solid #f3f4f6;">Click your state on the map above, then select your area. Ask the contractor listed about licensing and insurance for your service area when you call.</div>
      </details>
      <details style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
        <summary style="padding:16px 20px;font-weight:600;cursor:pointer;font-size:0.97rem;list-style:none;display:flex;justify-content:space-between;align-items:center;">Are the treatments safe for kids and pets?<span style="font-size:1.2rem;flex-shrink:0;margin-left:12px;">+</span></summary>
        <div style="padding:0 20px 16px;color:#374151;line-height:1.7;font-size:0.93rem;border-top:1px solid #f3f4f6;">Treatment products, methods, and re-entry intervals vary by contractor. Ask us which products they use and about any re-entry interval after an application.</div>
      </details>
      <details style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
        <summary style="padding:16px 20px;font-weight:600;cursor:pointer;font-size:0.97rem;list-style:none;display:flex;justify-content:space-between;align-items:center;">What pests do these contractors handle?<span style="font-size:1.2rem;flex-shrink:0;margin-left:12px;">+</span></summary>
        <div style="padding:0 20px 16px;color:#374151;line-height:1.7;font-size:0.93rem;border-top:1px solid #f3f4f6;">The full range of household pests: ants, cockroaches, termites, bed bugs, rodents (mice and rats), mosquitoes, spiders, fleas and ticks, wasps and hornets, silverfish, earwigs, and more — plus recurring prevention plans.</div>
      </details>
    </div>
  </div>
</section>

<div class="mobile-call-cta-wrap">
  <a class="mobile-call-cta" href="tel:${phoneTel}">
    <span class="mobile-call-cta-text">
      <span class="mobile-call-cta-label">Tap to Call</span>
      <span class="mobile-call-cta-number">${phoneDisplay}</span>
    </span>
  </a>
</div>

<script>
  // Defer the interactive US map (d3 + topojson) until the map section nears the
  // viewport. It is below the fold, so loading it eagerly only inflated Total
  // Blocking Time without helping the initial paint.
  (function () {
    var mapSection = document.getElementById('map-section');
    if (!mapSection) return;
    var started = false;
    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = src; s.onload = resolve; s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    async function initMap() {
      if (started) return; started = true;
      await loadScript('https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js');
      await loadScript('https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js');
      const { topo, fips } = await d3.json('/api/states-map');
      const states = topojson.feature(topo, topo.objects.states);
      const mesh = topojson.mesh(topo, topo.objects.states, (a, b) => a !== b);

      const svg = d3.select('#us-map');
      const container = svg.node().parentElement;
      const width = container.clientWidth;
      const height = Math.round(width * 0.62);

      svg.attr('viewBox', \`0 0 \${width} \${height}\`)
         .attr('width', '100%')
         .style('display', 'block');

      const projection = d3.geoAlbersUsa().fitSize([width, height], states);
      const path = d3.geoPath().projection(projection);
      const tooltip = document.getElementById('map-tooltip');

      svg.append('g')
        .selectAll('path')
        .data(states.features)
        .join('path')
          .attr('class', 'state')
          .attr('d', path)
          .on('mousemove', function(event, d) {
            const name = fips[d.id]?.name;
            if (!name) return;
            tooltip.textContent = name;
            tooltip.style.display = 'block';
            tooltip.style.left = (event.offsetX + 12) + 'px';
            tooltip.style.top = (event.offsetY - 10) + 'px';
          })
          .on('mouseleave', () => tooltip.style.display = 'none')
          .on('click', (event, d) => {
            const slug = fips[d.id]?.slug;
            const name = fips[d.id]?.name;
            if (!slug) return;
            // Only Georgia and Colorado are built. Every other state shows
            // the coming-soon panel instead of a 404.
            if (slug === 'georgia' || slug === 'colorado') {
              window.location.href = '/' + slug + '/';
            } else {
              var panel = document.getElementById('coming-soon-panel');
              var label = document.getElementById('coming-soon-state');
              if (label && name) label.textContent = name;
              if (panel) { panel.style.display = 'block'; panel.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
            }
          });

      svg.append('path')
        .datum(mesh)
        .attr('class', 'state-border')
        .attr('d', path);
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) { io.disconnect(); initMap(); }
      }, { rootMargin: '300px' });
      io.observe(mapSection);
    } else {
      initMap();
    }
  })();
</script>
` }) %>
