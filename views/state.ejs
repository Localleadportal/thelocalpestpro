<%
  // State hub page. One consumer-focused, SEO page covering every pest in the
  // state. Pest cards link out to the national /<service>/ pages — we do NOT
  // build per-state pest pages. Always shows the shared (844) directory number
  // (state pages have no single county-assigned contractor).
  const st = state;            // data/states.js entry
  const slug = st.slug;
  const name = st.name;
  const pageUrl = `${SITE.DOMAIN}/${slug}/`;
  const ogImage = `${SITE.DOMAIN}/favicon.png`;
  const phoneTel = SITE.PHONE_TEL;
  const phoneDisplay = SITE.PHONE_DISPLAY;

  const title = st.metaTitle || `Pest Control in ${name} | ${SITE.NAME}`;
  const metaDesc = st.metaDesc;
  const canonical = `/${slug}/`;

  // ── Schema graph ──
  // This is a STATE DIRECTORY HUB, not a single business — deliberately no
  // LocalBusiness / PestControl node (no one address). WebPage anchors the page
  // to the site's WebSite node (defined on the homepage), BreadcrumbList mirrors
  // the visible "Home › Georgia" trail (still a rich result), and an optional
  // FAQPage mirrors the visible Q&As (rich result retired 2026-05-07 — kept for
  // machine-readability only).
  const graph = [
    {
      "@type": "WebPage",
      "@id": pageUrl + "#webpage",
      "url": pageUrl,
      "name": `Pest Control in ${name}`,
      "description": metaDesc,
      "inLanguage": "en-US",
      "isPartOf": { "@id": `${SITE.DOMAIN}/#website` },
      "about": { "@type": "State", "name": name },
      "breadcrumb": { "@id": pageUrl + "#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": pageUrl + "#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE.DOMAIN}/` },
        { "@type": "ListItem", "position": 2, "name": name }
      ]
    }
  ];
  if (st.faqs && st.faqs.length) {
    graph.push({
      "@type": "FAQPage",
      "@id": pageUrl + "#faq",
      "mainEntity": st.faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    });
  }
  const schema = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });

  const extraHead = `
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="${SITE.NAME}">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="${pageUrl}">
    <meta property="og:title" content="${title}">
    <meta property="og:description" content="${metaDesc}">
    <meta property="og:image" content="${ogImage}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="${title}">
    <meta name="twitter:description" content="${metaDesc}">
    <meta name="twitter:image" content="${ogImage}">
    <meta name="robots" content="index, follow">
  `;

  // ── Fragments ──
  const overviewHtml = (st.overview || []).map(p => `<p>${p}</p>`).join('\n    ');

  const pestCardsHtml = (st.pests || []).map(p => `
      <a class="service-card" href="${p.href}" style="text-decoration:none;display:block;">
        <span class="card-icon">${p.emoji}</span>
        <h3>${p.name}</h3>
        <p>${p.blurb}</p>
        <span class="card-phone">Learn more &rsaquo;</span>
      </a>`).join('');

  const seasonsHtml = (st.seasons || []).map(s => `
      <div class="feature">
        <h3>${s.season}</h3>
        <p>${s.text}</p>
      </div>`).join('');

  // Cities We Service — grows one at a time. Plain badge unless an href exists.
  // Empty array → statewide fallback message instead of an empty grid.
  const citiesHtml = (st.cities && st.cities.length)
    ? `<ul class="counties-grid">
      ${st.cities.map(c => c.href
        ? `<li><a href="${c.href}">${c.name}</a></li>`
        : `<li><span style="display:block;padding:11px 16px;background:var(--green-light);border:1px solid var(--green-border);border-radius:var(--radius);color:var(--green);font-weight:600;font-size:0.92rem;">${c.name}</span></li>`).join('\n      ')}
    </ul>`
    : `<p style="text-align:center;color:var(--muted);max-width:640px;margin:0 auto;">We're actively expanding across ${name} and adding service areas as we grow. Don't see your city yet? Call <a class="llp-phone" href="tel:${phoneTel}" style="color:var(--green);font-weight:700;">${phoneDisplay}</a> — we serve communities statewide and can connect you with a licensed local exterminator.</p>`;

  const faqHtml = (st.faqs && st.faqs.length)
    ? `
<section class="county-content">
  <div class="container">
    <h2>Frequently Asked Questions — Pest Control in ${name}</h2>
    <div style="display:flex;flex-direction:column;gap:16px;margin-top:16px;">
      ${st.faqs.map((f, i) => `<details style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;"${i === 0 ? ' open' : ''}><summary style="padding:16px 20px;font-weight:600;cursor:pointer;font-size:0.97rem;list-style:none;display:flex;justify-content:space-between;align-items:center;">${f.q}<span style="font-size:1.2rem;flex-shrink:0;margin-left:12px;">+</span></summary><div style="padding:0 20px 16px;color:#374151;line-height:1.7;font-size:0.93rem;border-top:1px solid #f3f4f6;">${f.a}</div></details>`).join('')}
    </div>
  </div>
</section>` : '';

  const body = `
<nav class="breadcrumb">
  <div class="container">
    <a href="/">Home</a> &rsaquo; <span>${name}</span>
  </div>
</nav>

<section class="page-hero">
  <div class="container">
    <h1>Pest Control in ${name}</h1>
    <p>${st.heroSub}</p>
    <div class="hero-actions" style="justify-content:center;margin-top:24px;">
      <a href="tel:${phoneTel}" class="btn-primary">📞 ${phoneDisplay}</a>
      <a href="#pests" class="btn-ghost">See Pests We Treat</a>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h2>Free ${name} Pest Control Quote</h2>
      <p class="cta-sub">Connect with a licensed, insured local exterminator who knows ${name} pests.</p>
      <div class="phone-wrap">
        <a class="phone-cta" href="tel:${phoneTel}">📞 ${phoneDisplay}</a>
      </div>
      <p class="cta-note">Same-day &amp; emergency service available · Free, no-obligation quote</p>
      <div class="cta-badges">
        <span class="cta-badge"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>Licensed &amp; Insured</span>
        <span class="cta-badge"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Pet &amp; Family Safe</span>
        <span class="cta-badge"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>Local ${name} Pros</span>
      </div>
    </div>
  </div>
</section>

<section class="services-section" id="pests">
  <div class="container">
    <h2>Pests We Treat Across ${name}</h2>
    <p class="section-sub">From termites and fire ants to mosquitoes and rodents — tap any pest to learn how the pros handle it.</p>
    <div class="service-cards">${pestCardsHtml}
    </div>
  </div>
</section>

<section class="state-content">
  <div class="container">
    <h2>Why ${name} Homes Need Year-Round Pest Protection</h2>
    ${overviewHtml}
    <p>${st.regulationNote}</p>
  </div>
</section>

<section class="about">
  <div class="container">
    <div class="section-header">
      <h2>${name} Pest Season — What to Expect</h2>
      <p>Pest pressure shifts through the year. Here's what Georgia homeowners deal with and when.</p>
    </div>
    <div class="features">${seasonsHtml}
    </div>
  </div>
</section>

<section class="counties-section" style="background:var(--green-light);border-top:1px solid var(--green-border);">
  <div class="container">
    <div class="section-header">
      <h2>Cities We Service in ${name}</h2>
      <p>Local pest control coverage across ${name} — growing as we expand.</p>
    </div>
    ${citiesHtml}
  </div>
</section>

<section class="about" id="how-it-works" style="background:#fff;border-top:none;">
  <div class="container">
    <div class="section-header">
      <h2>How It Works</h2>
      <p>Three steps to a pest-free ${name} home.</p>
    </div>
    <div class="features">
      <div class="feature">
        <span class="feature-icon">📞</span>
        <h3>Call for a Free Quote</h3>
        <p>One call to ${phoneDisplay} connects you with a licensed local exterminator serving your ${name} area.</p>
      </div>
      <div class="feature">
        <span class="feature-icon">🛡️</span>
        <h3>Get a Custom Plan</h3>
        <p>Your pro inspects, identifies the pest, and quotes a treatment — one-time or recurring — built for your home.</p>
      </div>
      <div class="feature">
        <span class="feature-icon">✅</span>
        <h3>Problem Solved</h3>
        <p>Licensed, insured technicians treat, exclude, and prevent — and many back their work with a guarantee.</p>
      </div>
    </div>
  </div>
</section>${faqHtml}

<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h2>Ready to Get Rid of Pests in ${name}?</h2>
      <p class="cta-sub">Free quote · Same-day &amp; emergency service · Licensed local pros</p>
      <div class="phone-wrap">
        <a class="phone-cta" href="tel:${phoneTel}">📞 ${phoneDisplay}</a>
      </div>
    </div>
  </div>
</section>

<div class="mobile-call-cta-wrap">
  <a class="mobile-call-cta" href="tel:${phoneTel}">
    <span class="mobile-call-cta-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
    </span>
    <span class="mobile-call-cta-text">
      <span class="mobile-call-cta-label">Tap to Call — Free Quote</span>
      <span class="mobile-call-cta-number">${phoneDisplay}</span>
    </span>
  </a>
</div>`;
%>
<%- include('layout', { title, metaDesc, canonical, schema, extraHead, body }) %>
