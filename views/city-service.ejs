<%
  // City + pest page — e.g. /georgia/woodstock/termite-control/. Unique, hyper-
  // local content with the assigned LeadPortal contractor for the city's county
  // (LocalBusiness schema) or the (844) fallback.
  const st = state;
  const city = locals.city;
  const pg = page;             // city.pestPages[serviceSlug]
  const stateName = st.name;
  const cityName = city.name;
  const pageUrl = `${SITE.DOMAIN}/${st.slug}/${city.slug}/${serviceSlug}/`;
  const cityUrl = `${SITE.DOMAIN}/${st.slug}/${city.slug}/`;
  const stateUrl = `${SITE.DOMAIN}/${st.slug}/`;
  // OG card: the branded 1200×630 /images/og-default.jpg is the shared default;
  // a city can override per-page with city.ogImage (root-relative).
  const ogImage = `${SITE.DOMAIN}${city.ogImage || '/images/og-default.jpg'}`;
  const crumb = pg.breadcrumbName || pg.h1;

  const assigned = !!(contractor && contractor.assigned && contractor.name && contractor.telephone);
  // Business name comes from LeadPortal already correctly cased — display as-is.
  // (toTitleCase is for messy signup addresses; it would mangle "McCardle's".)
  const coName = assigned ? contractor.name : SITE.NAME;
  const coTel = assigned ? contractor.telephone : SITE.PHONE_TEL;
  const coDisp = assigned ? formatPhone(contractor.telephone) : SITE.PHONE_DISPLAY;

  const title = pg.metaTitle || `${pg.h1} | ${SITE.NAME}`;
  const metaDesc = pg.metaDesc;
  const canonical = `/${st.slug}/${city.slug}/${serviceSlug}/`;

  // ── Schema graph ──
  const graph = [
    {
      "@type": "WebPage",
      "@id": pageUrl + "#webpage",
      "url": pageUrl,
      "name": title,
      "description": metaDesc,
      "inLanguage": "en-US",
      "isPartOf": { "@id": `${SITE.DOMAIN}/#website` },
      "about": { "@type": "Thing", "name": pg.h1 },
      "breadcrumb": { "@id": pageUrl + "#breadcrumb" }
    },
    {
      "@type": "Service",
      "@id": pageUrl + "#service",
      "name": pg.h1,
      "serviceType": crumb,
      "description": metaDesc,
      "provider": assigned ? { "@id": pageUrl + "#localbusiness" } : { "@id": `${SITE.DOMAIN}/#organization` },
      "areaServed": { "@type": "City", "name": cityName, "containedInPlace": { "@type": "State", "name": stateName } }
    },
    {
      "@type": "BreadcrumbList",
      "@id": pageUrl + "#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE.DOMAIN}/` },
        { "@type": "ListItem", "position": 2, "name": stateName, "item": stateUrl },
        { "@type": "ListItem", "position": 3, "name": cityName, "item": cityUrl },
        { "@type": "ListItem", "position": 4, "name": crumb }
      ]
    }
  ];
  if (assigned) {
    const lb = {
      "@type": "PestControlService",
      "@id": pageUrl + "#localbusiness",
      "name": coName,
      "url": pageUrl,
      "image": contractor.image || ogImage,
      "telephone": coTel,
      "areaServed": { "@type": "City", "name": cityName, "containedInPlace": { "@type": "State", "name": stateName } }
    };
    const addr = {};
    if (contractor.streetAddress) addr.streetAddress = toTitleCase(contractor.streetAddress);
    addr.addressLocality = contractor.addressLocality ? toTitleCase(contractor.addressLocality) : cityName;
    addr.addressRegion = normalizeStateRegion(contractor.addressRegion || st.abbr);
    if (contractor.postalCode) addr.postalCode = contractor.postalCode;
    addr.addressCountry = "US";
    lb.address = Object.assign({ "@type": "PostalAddress" }, addr);
    if (contractor.licenseNumber) lb.hasCredential = `License ${contractor.licenseNumber}`;
    graph.push(lb);
  }
  if (pg.faqs && pg.faqs.length) {
    graph.push({
      "@type": "FAQPage",
      "@id": pageUrl + "#faq",
      "mainEntity": pg.faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
    });
  }
  const schema = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });

  const extraHead = `
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="${SITE.NAME}">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="${pageUrl}">
    <meta property="og:title" content="${title}">
    <meta property="og:description" content="${metaDesc}">
    <meta property="og:image" content="${ogImage}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="${title}">
    <meta name="twitter:description" content="${metaDesc}">
    <meta name="twitter:image" content="${ogImage}">
    <meta name="robots" content="index, follow">
  `;

  // Section renderer (alternating backgrounds).
  const sectionsHtml = (pg.sections || []).map((s, i) => {
    const bg = i % 2 === 0 ? 'county-content' : 'state-content';
    const paras = (s.paras || []).map(p => `<p>${p}</p>`).join('\n    ');
    const bullets = (s.bullets && s.bullets.length) ? `<ul class="tips-list">${s.bullets.map(b => `<li>${b}</li>`).join('')}</ul>` : '';
    const cards = (s.cards && s.cards.length) ? `<div class="features" style="margin-top:24px;">${s.cards.map(c => `<div class="feature"><h3>${c.name}</h3><p>${c.text}</p></div>`).join('')}</div>` : '';
    return `
<section class="${bg}">
  <div class="container">
    <h2>${s.heading}</h2>
    ${paras}
    ${bullets}
    ${cards}
  </div>
</section>`;
  }).join('');

  // Related Woodstock pest pages (canonical order; exclude current).
  const pestList = (typeof DEFAULT_PESTS !== 'undefined' && DEFAULT_PESTS) ? DEFAULT_PESTS : [];
  const related = pestList
    .map(p => ({ slug: p.href.replace(/^\/+|\/+$/g, ''), name: p.name }))
    .filter(p => p.slug !== serviceSlug && city.pestPages && city.pestPages[p.slug]);
  const relatedHtml = related.length ? `
<section class="counties-section" style="background:var(--green-light);border-top:1px solid var(--green-border);">
  <div class="container">
    <div class="section-header">
      <h2>More ${cityName} Pest Control</h2>
      <p>We handle every pest across ${cityName} &amp; ${city.county}.</p>
    </div>
    <ul class="counties-grid">
      ${related.map(p => `<li><a href="/${st.slug}/${city.slug}/${p.slug}/">${p.name} in ${cityName}</a></li>`).join('\n      ')}
    </ul>
  </div>
</section>` : '';

  const faqHtml = (pg.faqs && pg.faqs.length) ? `
<section class="county-content">
  <div class="container">
    <h2>${`Frequently Asked Questions — ${crumb} in ${cityName}`}</h2>
    <div style="display:flex;flex-direction:column;gap:16px;margin-top:16px;">
      ${pg.faqs.map((f, i) => `<details style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;"${i === 0 ? ' open' : ''}><summary style="padding:16px 20px;font-weight:600;cursor:pointer;font-size:0.97rem;list-style:none;display:flex;justify-content:space-between;align-items:center;">${f.q}<span style="font-size:1.2rem;flex-shrink:0;margin-left:12px;">+</span></summary><div style="padding:0 20px 16px;color:#374151;line-height:1.7;font-size:0.93rem;border-top:1px solid #f3f4f6;">${f.a}</div></details>`).join('')}
    </div>
  </div>
</section>` : '';

  const ctaBox = `
<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h2>${assigned ? `Call Your Local ${cityName} ${crumb} Pro` : `Free ${crumb} Quote in ${cityName}`}</h2>
      ${assigned ? `<p class="company-name">${coName}</p>` : ''}
      <p class="cta-sub">${assigned ? `Serving ${cityName} &amp; ${city.county} — free inspection, no obligation.` : `Connect with a licensed local pro who knows ${cityName} pests — free inspection, no obligation.`}</p>
      <div class="phone-wrap">
        <a class="phone-cta" href="tel:${coTel}">📞 ${coDisp}</a>
      </div>
      <p class="cta-note">Same-day &amp; emergency service available · Free, no-obligation quote</p>
      <div class="cta-badges">
        <span class="cta-badge"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>Licensed &amp; Insured</span>
        <span class="cta-badge"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Pet &amp; Family Safe</span>
        <span class="cta-badge"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>Local ${cityName} Pros</span>
      </div>
    </div>
  </div>
</section>`;

  const body = `
<nav class="breadcrumb">
  <div class="container">
    <a href="/">Home</a> &rsaquo; <a href="/${st.slug}/">${stateName}</a> &rsaquo; <a href="/${st.slug}/${city.slug}/">${cityName}</a> &rsaquo; <span>${crumb}</span>
  </div>
</nav>

<section class="page-hero">
  <div class="container">
    <h1>${pg.h1}</h1>
    <p>${pg.heroSub}</p>
    <div class="hero-actions" style="justify-content:center;margin-top:24px;">
      <a href="tel:${coTel}" class="btn-primary">📞 ${coDisp}</a>
      <a href="#faq" class="btn-ghost">Common Questions</a>
    </div>
  </div>
</section>
${ctaBox}
${sectionsHtml}
${relatedHtml}${faqHtml}

<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h2>${pg.finalCtaHeading || `Get Rid of Your Pest Problem in ${cityName}`}</h2>
      <p class="cta-sub">Free quote · Same-day &amp; emergency service · Licensed local pros</p>
      <div class="phone-wrap">
        <a class="phone-cta" href="tel:${coTel}">📞 ${coDisp}</a>
      </div>
    </div>
  </div>
</section>

<div class="mobile-call-cta-wrap">
  <a class="mobile-call-cta" href="tel:${coTel}">
    <span class="mobile-call-cta-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
    </span>
    <span class="mobile-call-cta-text">
      <span class="mobile-call-cta-label">${assigned ? 'Tap to Call — ' + coName : 'Tap to Call — Free Quote'}</span>
      <span class="mobile-call-cta-number">${coDisp}</span>
    </span>
  </a>
</div>`;
%>
<%- include('layout', { title, metaDesc, canonical, schema, extraHead, body }) %>
