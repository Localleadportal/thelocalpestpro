<%
  // City hub page — e.g. /georgia/woodstock/. Localized, unique content covering
  // every pest in the city, with the assigned LeadPortal contractor (when one is
  // assigned to the city's county) shown as a local pro plus LocalBusiness
  // schema. Falls back to the shared (844) line until a contractor is assigned.
  const st = state;            // data/states.js state entry
  const city = locals.city;    // data/cities/<city>.js
  const stateName = st.name;
  const cityName = city.name;
  const pageUrl = `${SITE.DOMAIN}/${st.slug}/${city.slug}/`;
  const stateUrl = `${SITE.DOMAIN}/${st.slug}/`;
  // OG card: the branded 1200×630 /images/og-default.jpg is the shared default;
  // a city can override per-page with city.ogImage (root-relative).
  const ogImage = `${SITE.DOMAIN}${city.ogImage || '/images/og-default.jpg'}`;

  // Contractor (assigned local pro) vs. shared directory fallback.
  const assigned = !!(contractor && contractor.assigned && contractor.name && contractor.telephone);
  // Business name comes from LeadPortal already correctly cased — display as-is.
  // (toTitleCase is for messy signup addresses; it would mangle "McCardle's".)
  const coName = assigned ? contractor.name : SITE.NAME;
  const coTel = assigned ? contractor.telephone : SITE.PHONE_TEL;
  const coDisp = assigned ? formatPhone(contractor.telephone) : SITE.PHONE_DISPLAY;

  const title = city.metaTitle || `${cityName} Pest Control | ${SITE.NAME}`;
  const metaDesc = city.metaDesc;
  const canonical = `/${st.slug}/${city.slug}/`;

  // slug -> {emoji, name} from the canonical six (homepage order preserved).
  const pestList = (typeof DEFAULT_PESTS !== 'undefined' && DEFAULT_PESTS) ? DEFAULT_PESTS : [];

  // ── Schema graph ──
  const graph = [
    {
      "@type": "WebPage",
      "@id": pageUrl + "#webpage",
      "url": pageUrl,
      "name": title,
      "description": metaDesc,
      "inLanguage": "en-US",
      "isPartOf": { "@id": `${SITE.DOMAIN}/#website` },
      "about": { "@type": "Thing", "name": `Pest Control in ${cityName}, ${st.abbr}` },
      "breadcrumb": { "@id": pageUrl + "#breadcrumb" }
    },
    {
      "@type": "Service",
      "@id": pageUrl + "#service",
      "name": `Pest Control in ${cityName}, ${st.abbr}`,
      "serviceType": SITE.SERVICE_TYPE,
      "description": metaDesc,
      "provider": assigned ? { "@id": pageUrl + "#localbusiness" } : { "@id": `${SITE.DOMAIN}/#organization` },
      "areaServed": { "@type": "City", "name": cityName, "containedInPlace": { "@type": "State", "name": stateName } }
    },
    {
      "@type": "BreadcrumbList",
      "@id": pageUrl + "#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE.DOMAIN}/` },
        { "@type": "ListItem", "position": 2, "name": stateName, "item": stateUrl },
        { "@type": "ListItem", "position": 3, "name": cityName }
      ]
    }
  ];
  // LocalBusiness only when a real contractor is assigned (directory guardrail).
  if (assigned) {
    const lb = {
      "@type": "PestControlService",
      "@id": pageUrl + "#localbusiness",
      "name": coName,
      "url": pageUrl,
      "image": contractor.image || ogImage,
      "telephone": coTel,
      "areaServed": { "@type": "City", "name": cityName, "containedInPlace": { "@type": "State", "name": stateName } }
    };
    // Address comes ONLY from the contractor's real LeadPortal record — never
    // synthesized from the page's city/state (that would be a fabricated-locality
    // claim). A real address needs a street; without one we omit address entirely
    // and let areaServed (page City + State) carry the coverage signal. The
    // contractor's real HQ may sit in a different city than the page — that's
    // honest, so we render it verbatim from their record.
    if (contractor.streetAddress) {
      const addr = { "@type": "PostalAddress", "streetAddress": toTitleCase(contractor.streetAddress) };
      if (contractor.addressLocality) addr.addressLocality = toTitleCase(contractor.addressLocality);
      if (contractor.addressRegion) addr.addressRegion = normalizeStateRegion(contractor.addressRegion);
      if (contractor.postalCode) addr.postalCode = contractor.postalCode;
      addr.addressCountry = "US";
      lb.address = addr;
    }
    if (contractor.licenseNumber) lb.hasCredential = `License ${contractor.licenseNumber}`;
    graph.push(lb);
  }
  if (city.faqs && city.faqs.length) {
    graph.push({
      "@type": "FAQPage",
      "@id": pageUrl + "#faq",
      "mainEntity": city.faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
    });
  }
  const schema = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });

  const extraHead = `
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="${SITE.NAME}">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="${pageUrl}">
    <meta property="og:title" content="${title}">
    <meta property="og:description" content="${metaDesc}">
    <meta property="og:image" content="${ogImage}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="${title}">
    <meta name="twitter:description" content="${metaDesc}">
    <meta name="twitter:image" content="${ogImage}">
    <meta name="robots" content="index, follow">
  `;

  // ── Fragments ──
  const overviewHtml = (city.overview || []).map(p => `<p>${p}</p>`).join('\n    ');

  // Pest cards. Prefer an explicit city.pests array — this lets a hub render all
  // its cards while the per-pest pages are still being authored one at a time.
  // A card is a LINK only when its per-pest spoke page actually exists in
  // city.pestPages; otherwise it renders as a non-clickable <div>. That keeps the
  // hub from emitting internal links to not-yet-built (404) spoke URLs — no soft
  // 404s, no link equity bled into dead ends — and each card auto-upgrades to a
  // link the moment its spoke is authored. Otherwise derive cards from pestPages
  // in canonical order (only pests with a built city page render).
  const pestCardsHtml = (city.pests && city.pests.length)
    ? city.pests.map(p => {
        const ps = (p.href || '').replace(/\/+$/, '').split('/').pop();
        const built = !!(city.pestPages && city.pestPages[ps]);
        const inner = `
        <span class="card-icon">${p.emoji}</span>
        <h3>${p.name}</h3>
        <p>${p.blurb}</p>
        ${built ? '<span class="card-phone">Learn more &rsaquo;</span>' : ''}`;
        return built
          ? `
      <a class="service-card" href="${p.href}" style="text-decoration:none;display:block;">${inner}
      </a>`
          : `
      <div class="service-card">${inner}
      </div>`;
      }).join('')
    : pestList.map(p => {
        const ps = p.href.replace(/^\/+|\/+$/g, '');
        const cp = city.pestPages && city.pestPages[ps];
        if (!cp) return '';
        return `
      <a class="service-card" href="/${st.slug}/${city.slug}/${ps}/" style="text-decoration:none;display:block;">
        <span class="card-icon">${p.emoji}</span>
        <h3>${p.name}</h3>
        <p>${cp.cardBlurb}</p>
        <span class="card-phone">Learn more &rsaquo;</span>
      </a>`;
      }).join('');

  // Nearby-area badges. When a neighborhood has its own built city hub in this
  // state (matched by name against st.cities, which carries the linkable href),
  // render it as a real link; otherwise keep it as a plain, non-clickable badge.
  // Never self-link the current city.
  const nearbyHref = {};
  (st.cities || []).forEach(c => {
    if (c.href && c.slug !== city.slug) nearbyHref[c.name.toLowerCase()] = c.href;
  });
  const badgeStyle = 'display:block;padding:11px 16px;background:var(--green-light);border:1px solid var(--green-border);border-radius:var(--radius);color:var(--green);font-weight:600;font-size:0.92rem;';
  const areasGrid = (city.neighborhoods && city.neighborhoods.length)
    ? `<ul class="counties-grid" style="margin-top:8px;">
      ${city.neighborhoods.map(n => {
        const href = nearbyHref[n.toLowerCase()];
        return href
          ? `<li><a href="${href}" style="${badgeStyle}text-decoration:none;">${n}</a></li>`
          : `<li><span style="${badgeStyle}">${n}</span></li>`;
      }).join('\n      ')}
    </ul>
    ${city.zips && city.zips.length ? `<p style="text-align:center;color:var(--muted);margin-top:16px;">Serving ZIP codes ${city.zips.join(' &amp; ')} and all of ${city.county}.</p>` : ''}`
    : '';

  // Section renderer (alternating backgrounds); supports the neighborhoods grid.
  const sectionsHtml = (city.sections || []).map((s, i) => {
    const bg = i % 2 === 0 ? 'state-content' : 'county-content';
    const paras = (s.paras || []).map(p => `<p>${p}</p>`).join('\n    ');
    const bullets = (s.bullets && s.bullets.length) ? `<ul class="tips-list">${s.bullets.map(b => `<li>${b}</li>`).join('')}</ul>` : '';
    const cards = (s.cards && s.cards.length) ? `<div class="features" style="margin-top:24px;">${s.cards.map(c => `<div class="feature"><h3>${c.name}</h3><p>${c.text}</p></div>`).join('')}</div>` : '';
    const areas = s.areas ? areasGrid : '';
    return `
<section class="${bg}">
  <div class="container">
    <h2>${s.heading}</h2>
    ${paras}
    ${bullets}
    ${cards}
    ${areas}
  </div>
</section>`;
  }).join('');

  const faqHtml = (city.faqs && city.faqs.length) ? `
<section class="county-content">
  <div class="container">
    <h2>Frequently Asked Questions — Pest Control in ${cityName}</h2>
    <div style="display:flex;flex-direction:column;gap:16px;margin-top:16px;">
      ${city.faqs.map((f, i) => `<details style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;"${i === 0 ? ' open' : ''}><summary style="padding:16px 20px;font-weight:600;cursor:pointer;font-size:0.97rem;list-style:none;display:flex;justify-content:space-between;align-items:center;">${f.q}<span style="font-size:1.2rem;flex-shrink:0;margin-left:12px;">+</span></summary><div style="padding:0 20px 16px;color:#374151;line-height:1.7;font-size:0.93rem;border-top:1px solid #f3f4f6;">${f.a}</div></details>`).join('')}
    </div>
  </div>
</section>` : '';

  // Contractor CTA box — names the local pro when assigned.
  const ctaBox = `
<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h2>${assigned ? `Call Your Local ${cityName} Pest Pro` : `Free ${cityName} Pest Control Quote`}</h2>
      ${assigned ? `<p class="company-name">${coName}</p>` : ''}
      <p class="cta-sub">${assigned ? `Serving ${cityName} &amp; ${city.county} — free inspection, no obligation.` : `Connect with a licensed, insured local pro who knows ${cityName} pests — free inspection, no obligation.`}</p>
      <div class="phone-wrap">
        <a class="phone-cta" href="tel:${coTel}">📞 ${coDisp}</a>
      </div>
      <p class="cta-note">Same-day &amp; emergency service available · Free, no-obligation quote</p>
      <div class="cta-badges">
        <span class="cta-badge"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>Licensed &amp; Insured</span>
        <span class="cta-badge"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Pet &amp; Family Safe</span>
        <span class="cta-badge"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>Local ${cityName} Pros</span>
      </div>
    </div>
  </div>
</section>`;

  const body = `
<nav class="breadcrumb">
  <div class="container">
    <a href="/">Home</a> &rsaquo; <a href="/${st.slug}/">${stateName}</a> &rsaquo; <span>${cityName}</span>
  </div>
</nav>

<section class="page-hero">
  <div class="container">
    <h1>${city.h1}</h1>
    <p>${city.heroSub}</p>
    <div class="hero-actions" style="justify-content:center;margin-top:24px;">
      <a href="tel:${coTel}" class="btn-primary">📞 ${coDisp}</a>
      <a href="#pests" class="btn-ghost">Pests We Treat</a>
    </div>
  </div>
</section>
${ctaBox}

<section class="services-section" id="pests">
  <div class="container">
    <h2>Pest Control Services in ${cityName}</h2>
    <p class="section-sub">Local treatment for the pests ${cityName} homeowners deal with most — tap any for details.</p>
    <div class="service-cards">${pestCardsHtml}
    </div>
  </div>
</section>

<section class="state-content" style="border-top:none;">
  <div class="container">
    <h2>${city.overviewHeading || `Local Pest Control for ${cityName} Homes`}</h2>
    ${overviewHtml}
  </div>
</section>
${sectionsHtml}
${faqHtml}

<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h2>${city.finalCtaHeading || `Get Your Free ${cityName} Pest Control Quote`}</h2>
      <p class="cta-sub">Free quote · Same-day &amp; emergency service · Licensed local pros</p>
      <div class="phone-wrap">
        <a class="phone-cta" href="tel:${coTel}">📞 ${coDisp}</a>
      </div>
    </div>
  </div>
</section>

<div class="mobile-call-cta-wrap">
  <a class="mobile-call-cta" href="tel:${coTel}">
    <span class="mobile-call-cta-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
    </span>
    <span class="mobile-call-cta-text">
      <span class="mobile-call-cta-label">${assigned ? 'Tap to Call — ' + coName : 'Tap to Call — Free Quote'}</span>
      <span class="mobile-call-cta-number">${coDisp}</span>
    </span>
  </a>
</div>`;
%>
<%- include('layout', { title, metaDesc, canonical, schema, extraHead, body }) %>
